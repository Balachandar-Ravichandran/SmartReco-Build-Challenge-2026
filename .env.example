# PATHWISE — Behavioral AI Recommendation Engine
# Copy this to .env and fill in your actual values
# This file contains ONLY Mesh API configuration (competition-safe)
# NOTE: .env is git-ignored and local-only

# ==================== MESH API (Production) ====================
MESH_API_KEY=your_mesh_api_key_here
MESH_API_BASE=https://api.meshapi.ai/v1
# Hard timeouts for LLM calls to prevent hangs
MESH_EMBED_TIMEOUT_SEC=3
MESH_COMPLETE_TIMEOUT_SEC=6
# Mesh is a multi-provider aggregator — model ids need a provider prefix.
# Confirm against GET {MESH_API_BASE}/models before changing these.
MESH_EMBED_MODEL=vertex/gemini-embedding-001
MESH_COMPLETION_MODEL=google/gemini-3.5-flash-lite

# ==================== DATABASE ====================
DATABASE_URL=sqlite:///pathwise.db
# For dev: can override to file path, e.g.:
# DATABASE_URL=sqlite:////absolute/path/to/pathwise.db

# ==================== VECTOR STORE ====================
CHROMA_PATH=./chroma_data
# Chroma runs in-process (no external service needed)

# ==================== RECOMMENDATION THRESHOLDS ====================
SEMANTIC_THRESHOLD=0.65
KEYWORD_THRESHOLD=0.3
MIN_ACCEPT_SCORE=0.5

# ==================== SCHEDULER ====================
PROACTIVE_REFRESH_INTERVAL_MINUTES=360
RECONCILIATION_INTERVAL_MINUTES=5

# ==================== DAILY DIGEST (bonus) ====================
# Off by default (same reasoning as proactive-refresh). Flip on once SMTP
# creds below are filled in; DIGEST_HOUR/MINUTE are in server-local time.
ENABLE_DAILY_DIGEST=false
DIGEST_HOUR=8
DIGEST_MINUTE=0

# ==================== SMTP (daily digest delivery) ====================
# Leave blank to run the digest job in log-only stub mode (prints the
# rendered email instead of sending) — useful for testing before you have
# real credentials. Example for Gmail: smtp.gmail.com / 587 / an App
# Password (not your normal password).
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=
SMTP_USE_TLS=true

# ==================== EVENT LOGGING ====================
EVENTS_LOG_DIR=./logs
EVENTS_MAX_PER_MINUTE=120

# ==================== LANGSMITH (Optional - observability bonus) ====================
# Leave unset to run without tracing (app works identically, just untraced)
# LANGCHAIN_TRACING_V2=true
# LANGCHAIN_API_KEY=your_langsmith_key_here
# LANGCHAIN_PROJECT=pathwise-hackathon

# ==================== FASTAPI ====================
DEBUG=False
HOST=127.0.0.1
PORT=8000
WORKERS=1

# ==================== TOPIC VOCABULARY ====================
# Controlled enum for onboarding topics and product/path tags
# Used to prevent vocabulary mismatches between user input and catalog
TOPIC_VOCABULARY=Agentic AI,Machine Learning,Data Engineering,Generative AI,Cloud & DevOps,Cybersecurity,Product & Design,Business & Finance,Mobile Development,Career Skills,MLOps,Python for AI
